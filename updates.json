  "studyMaterials": [
    {
      "id": "material_1790316466027",
      "subject": "Effective Communications",
      "tag": "Study Material",
      "color": "border-l-4 border-blue-500",
      "title": "Academic and Technical Communication",
      "summary": "Similarities and difference of Academic and Technical Communication",
      "blocks": [
        {
          "type": "heading",
          "level": "h3",
          "text": "1. Formal Communication"
        },
        {
          "type": "paragraph",
          "text": "Formal Communication is the structured exchange of information, following predefined channels, hierarchy, and professional standards. It includes emails, reports, memos, letters, and other documented formats, ensuring clarity, authority, and consistency in workplace communication."
        },
        {
          "type": "paragraph",
          "text": "Formal Communication can be divided into Academic and Technical Communication."
        },
        {
          "type": "table",
          "title": "",
          "headers": [
            "Academic",
            "",
            "technical"
          ],
          "rows": [
            [
              "Build/discover",
              "Formal & Organized",
              "Solve & guide"
            ],
            [
              "Used in academia",
              "Audience-catered",
              "Used by professionals"
            ],
            [
              "Research",
              "Professional Language",
              "Task"
            ],
            [
              "Explain & Analyze",
              "Structured",
              "Instructional"
            ],
            [
              "Unredacted and cited",
              "Evidence",
              "Direct and concise"
            ]
          ]
        },
        {
          "type": "heading",
          "level": "h3",
          "text": "2. Academic Communication"
        },
        {
          "type": "paragraph",
          "text": "Academic communication is the formal exchange of ideas, information, and knowledge in educational and research settings. It includes essays, research papers, presentations, discussions, and academic reports."
        },
        {
          "type": "paragraph",
          "text": "It uses clear, organized, and formal language to present arguments, explain concepts, and support ideas with evidence. Its goal is to communicate information accurately and effectively to an academic audience."
        },
        {
          "type": "paragraph",
          "text": "Examples are:"
        },
        {
          "type": "bullets",
          "items": [
            "Research paper",
            "Academic essay",
            "Thesis",
            "Book review",
            "Classroom discussion"
          ]
        },
        {
          "type": "heading",
          "level": "h3",
          "text": "3. Technical Communication"
        },
        {
          "type": "paragraph",
          "text": "Technical communication is the process of presenting specialized information clearly and accurately to a specific audience. It is commonly used in fields such as science, engineering, technology, and business."
        },
        {
          "type": "paragraph",
          "text": "It includes manuals, reports, instructions, proposals, and technical documents. Its main goal is to help readers understand information, solve problems, or perform tasks effectively."
        },
        {
          "type": "paragraph",
          "text": "Examples are:"
        },
        {
          "type": "bullets",
          "items": [
            "User manual",
            "Instruction guide",
            "Technical report",
            "Product specification",
            "Safety instructions"
          ]
        }
      ]
    }
  ],
